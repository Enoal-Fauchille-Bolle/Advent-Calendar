{
  "name": "advent-calendar",
  "private": true,
  "description": "Password-protected advent calendar whose doors unlock day by day.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p src/client/tsconfig.build.json && tsc -p src/sw/tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "make-hash": "node src/cli/hash-password.ts",
    "make-vapid": "node src/cli/make-vapid.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "tsc --noEmit && tsc -p src/client --noEmit && tsc -p src/sw --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/web-push": "3.6.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.2.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "image-size": "2.0.4",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  }
}
